# Optional. Leer lassen, solange kein CoinGecko-Schlüssel vorhanden ist.
# Der Schlüssel wird nur als Anfragekopf gesendet und steht nicht im Code.
COINGECKO_API_KEY=

# Nur Paper-Schlüssel von Alpaca. Live-Schlüssel gehören hier nicht hinein.
# Der Endpunkt ist fest der Paper-Server. Ein Live-Endpunkt wird abgewiesen.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets
